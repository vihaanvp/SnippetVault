# =============================================================================
# SnippetVault — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Flask Secret Key ---
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated on each start (sessions invalidated on restart).
SECRET_KEY=

# --- OAuth: Google ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add redirect URI:  https://your-domain.com/login/google/authorize
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub ---
# Create an OAuth App at https://github.com/settings/developers
# Callback URL:  https://your-domain.com/login/github/authorize
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Public URL (optional but recommended behind reverse proxy) ---
# The full URL where SnippetVault is accessible from the internet.
# Set this if OAuth redirects fail due to Host-header mismatch behind a proxy.
# Example: https://snippetvault.vihaanvp.me
PUBLIC_URL=https://snippetvault.vihaanvp.me

# --- URL Scheme (optional) ---
# Set to "http" if running behind a plain HTTP reverse proxy.
# Defaults to "https".
PREFERRED_URL_SCHEME=https

# --- Database (optional) ---
# Directory where snippets.db is stored. Defaults to <project>/instance/
# In Docker, mount a volume here: /app/data
DATABASE_DIR=/app/data

# --- Server ---
PORT=5001
HOST=0.0.0.0
